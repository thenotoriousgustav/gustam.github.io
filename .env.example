# Use separate Neon branches and Blob stores for local/preview and production.
DATABASE_URL=postgresql://user:password@host/portfolio?sslmode=require
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
# Optional: more origins the admin may be used from, comma-separated (no paths).
# localhost:3000 is always allowed outside production.
APP_EXTRA_ORIGINS=
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_storeid_randomtoken

# Set only for the one-time manager bootstrap command; do not commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
